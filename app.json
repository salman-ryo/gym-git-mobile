{
  "expo": {
    "name": "Gym-Git",
    "slug": "gymgit-mobile",
    "version": "1.0.0",
    "description": "Commit your workouts like code - Scientific fitness tracking & GitHub-style activity heatmaps.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymgit",
    "userInterfaceStyle": "dark",
    "primaryColor": "#10b981",
    "backgroundColor": "#09090b",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymgit.mobile",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.gymgit.mobile",
      "backgroundColor": "#09090b",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash.png",
          "imageWidth": 120
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}